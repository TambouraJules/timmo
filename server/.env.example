# Copy this file to .env and fill in real values before running the server.

# MongoDB connection string. Use MongoDB Atlas (free tier) or a local instance:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/timmo
MONGODB_URI=mongodb://127.0.0.1:27017/timmo

# Any long random string, used to sign login tokens.
JWT_SECRET=change-this-to-a-long-random-string

# Port the API listens on. The frontend's TI_API_BASE in js/db.js
# must match: http://localhost:PORT/api
PORT=4000

# Address of the website (Vercel), without a trailing slash. Used to build the
# "Réinitialiser mon mot de passe" link sent by email, e.g.
# https://timmo.vercel.app — strongly recommended: without it, the link is only
# sent when the request comes from a *.vercel.app domain or localhost.
FRONTEND_URL=

# Optional: powers the "mot de passe oublié" email (reset link valid 30 min).
# Sign up free at https://resend.com, verify a sending domain (or use their
# default onboarding.resend.dev sender for testing), and paste the API key
# below. Without this variable, no email is actually sent — check the
# server logs. Note: the default onboarding@resend.dev sender can only send to
# the email address of your own Resend account; to reach real users, verify
# your own domain in Resend and set RESEND_FROM (e.g. Timmo <no-reply@timmo.sn>).
RESEND_API_KEY=
# Optional: sender shown in the email. Defaults to "Timmo <onboarding@resend.dev>"
# if left blank, which works for testing without a verified domain.
RESEND_FROM=

# Optional: lets agencies pay their monthly platform subscription by mobile
# money (Wave, Orange Money, card) through PayDunya, a West African payment
# aggregator with self-service signup at https://paydunya.com (Orange Money's
# own API requires a lengthy merchant approval). The money lands in YOUR
# PayDunya merchant account; the platform admin sees every payment in the
# Paiements panel. Tenant rent and deposits do NOT go through the platform.
# Create an "app" in your PayDunya dashboard and copy its 3 API keys below.
# Without them, the subscription "pay" button shows a clear "not configured"
# message instead of faking a payment (the admin can still record a payment
# received by other means).
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
# "test" (default, uses PayDunya's sandbox — no real money moves) or "live"
# (uses your real, approved PayDunya account — real money moves).
PAYDUNYA_MODE=test
# Optional: public address of this API, used as the PayDunya IPN callback
# (https://<api>/api/payment-gateway/ipn). Defaults to https://<request host>.
API_PUBLIC_URL=
