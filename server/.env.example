# Copy this file to .env and fill in real values before running the server.

# MongoDB connection string. Use MongoDB Atlas (free tier) or a local instance:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/timmo
MONGODB_URI=mongodb://127.0.0.1:27017/timmo

# Any long random string, used to sign login tokens.
JWT_SECRET=change-this-to-a-long-random-string

# Port the API listens on. The frontend's TI_API_BASE in js/db.js
# must match: http://localhost:PORT/api
PORT=4000

# Optional: powers the "mot de passe oublié" email (temporary password).
# Sign up free at https://resend.com, verify a sending domain (or use their
# default onboarding.resend.dev sender for testing), and paste the API key
# below. Without this variable, the feature still runs (a new temporary
# password is set) but no email is actually sent — check the server logs.
RESEND_API_KEY=
# Optional: sender shown in the email. Defaults to "Timmo <onboarding@resend.dev>"
# if left blank, which works for testing without a verified domain.
RESEND_FROM=

# Optional: powers real payment processing (Wave, Orange Money, card) via
# PayDunya — a West African payment aggregator with self-service signup at
# https://paydunya.com (unlike Orange Money's own API, which requires a
# lengthy merchant approval process with the local operator). Create a
# free account, create an "app" in your dashboard, and copy its 3 API
# keys below. Without these, payment buttons show a clear "not configured"
# message instead of silently faking a payment.
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
# "test" (default, uses PayDunya's sandbox — no real money moves) or "live"
# (uses your real, approved PayDunya account — real money moves).
PAYDUNYA_MODE=test

# Optional: powers automated SMS rent-payment reminders (sent 3 days
# before an installment is due, then again once it's overdue). Uses
# Twilio — self-service signup at https://www.twilio.com, no telecom
# operator approval needed to start (unlike Orange's own SMS API).
# Create a free trial account, buy or verify a sending phone number, and
# paste the 3 values below. Without these, reminders are simply skipped
# (no error, no code change needed).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio phone number that sends the SMS, in international format,
# e.g. +14155238886 (Twilio trial accounts get one automatically).
TWILIO_PHONE_NUMBER=
