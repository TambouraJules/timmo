# Copy this file to .env and fill in real values before running the server.

# MongoDB connection string. Use MongoDB Atlas (free tier) or a local instance:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/timmo
MONGODB_URI=mongodb://127.0.0.1:27017/timmo

# Any long random string, used to sign login tokens.
JWT_SECRET=change-this-to-a-long-random-string

# Port the API listens on. The frontend's TI_API_BASE in js/db.js
# must match: http://localhost:PORT/api
PORT=4000

# Optional: powers the "mot de passe oublié" email (temporary password).
# Sign up free at https://resend.com, verify a sending domain (or use their
# default onboarding.resend.dev sender for testing), and paste the API key
# below. Without this variable, the feature still runs (a new temporary
# password is set) but no email is actually sent — check the server logs.
RESEND_API_KEY=
# Optional: sender shown in the email. Defaults to "Timmo <onboarding@resend.dev>"
# if left blank, which works for testing without a verified domain.
RESEND_FROM=
